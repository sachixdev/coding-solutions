#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        int teztz;
        cin >> teztz;

        if (teztz % 3 == 0) {
            cout << 0 << '\n';
        } 
        else if (teztz % 3 == 2) {
            cout << 1 << '\n';
        } 
        else {
            int nxt = (teztz / 5 + 1) * 5;

            if (nxt % 3 == 0)
                cout << 1 << '\n';
            else
                cout << 2 << '\n';
        }
    }

    return 0;
}