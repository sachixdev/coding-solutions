#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        long long M;
        cin >> N >> M;

        vector<int> A(N);

        for (int i = 0; i < N; i++) {
            cin >> A[i];
        }

        sort(A.begin(), A.end());

        long long people = 0;
        int groups = 0;

        for (int i = 0; i < N; i++) {
            people += A[i];

            long long handshakes = people * (people - 1) / 2;

            if (handshakes <= M) {
                groups++;
            } else {
                break;
            }
        }

        cout << groups << endl;
    }

    return 0;
}