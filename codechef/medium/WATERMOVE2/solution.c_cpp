
#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N, K;
        cin >> N >> K;

        vector<int> A(N);

        for (int i = 0; i < N; i++) {
            cin >> A[i];
        }

        sort(A.begin(), A.end(), greater<int>());

        int ans = A[0];

        for (int i = 1; i < N && i <= K; i++) {
            ans += A[i];
        }

        cout << ans << endl;
    }

    return 0;
}
