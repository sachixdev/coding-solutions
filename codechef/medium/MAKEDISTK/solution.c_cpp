#include <bits/stdc++.h>
using namespace std;

bool possible(const vector<long long>& a, long long K, long long m) {
    long long cur = -(1LL << 60);
    long long total = 0;

    for (long long x : a) {
        cur = max(x, cur + 1);

        // This element needs more than m increments.
        if (cur - x > m)
            return false;

        total += cur - x;

        // We can perform at most m*K increments.
        if (total > m * K)
            return false;
    }

    return true;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        int N;
        long long K;
        cin >> N >> K;

        vector<long long> a(N);
        for (auto &x : a)
            cin >> x;

        sort(a.begin(), a.end());

        long long lo = 0, hi = 1LL * N * N;

        while (lo < hi) {
            long long mid = lo + (hi - lo) / 2;

            if (possible(a, K, mid))
                hi = mid;
            else
                lo = mid + 1;
        }

        cout << lo << '\n';
    }

    return 0;
}