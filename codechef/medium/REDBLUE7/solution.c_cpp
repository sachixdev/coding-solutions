#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        vector<long long> A(N);
        long long S = 0;

        for (int i = 0; i < N; i++) {
            cin >> A[i];
            S += A[i];
        }

        sort(A.begin(), A.end());

        vector<long long> pref(N + 1, 0);
        for (int i = 0; i < N; i++) {
            pref[i + 1] = pref[i] + A[i];
        }

        long long ans = 0;

        for (int r = 0; r <= N; r++) {
            long long SR;

            if (N - 2 * r >= 0) {
                // choose r largest elements
                SR = S - pref[N - r];
            } else {
                // choose r smallest elements
                SR = pref[r];
            }

            long long val = S * 1LL * r + SR * 1LL * (N - 2 * r);
            ans = max(ans, val);
        }

        cout << ans << "\n";
    }

    return 0;
}