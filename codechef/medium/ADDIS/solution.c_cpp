#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	 ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        unordered_map<long long, int> freq;
        int ans = 0;

        for (int i = 0; i < N; i++) {
            long long x;
            cin >> x;
            freq[x]++;
        }

        for (auto &p : freq) {
            ans = max(ans, (p.second + 1) / 2);
        }

        cout << ans << '\n';
    }

    return 0;


}
