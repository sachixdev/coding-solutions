
#include <bits/stdc++.h>
using namespace std;

using ll = long long;
using i128 = __int128_t;

i128 minSum(ll k) {
    return (i128)k * ((i128)k * k + 5) / 6;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        ll N;
        cin >> N;

        ll low = 1, high = 2000000;
        ll ans = 1;

        while (low <= high) {
            ll mid = low + (high - low) / 2;

            if (minSum(mid) <= N) {
                ans = mid;
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }

        cout << ans << '\n';
    }

    return 0;
}
