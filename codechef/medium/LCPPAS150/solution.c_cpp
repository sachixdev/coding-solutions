
#include <iostream>
using namespace std;


int main() {
    // Complete the code
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>> n;
        if(n%2 == 0){
            cout<<"Even"<<endl;
        }
        else{
            cout<<"Odd"<<endl;
        }
    }
    
    
    return 0;
}