
#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        vector<int> A(N);

        for (int i = 0; i < N; i++) {
            cin >> A[i];
        }

        if (N == 2) {
            cout << 0 << endl;
        } else {
            sort(A.begin(), A.end());

            int ans = min(A[N - 1] - A[1],
                          A[N - 2] - A[0]);

            cout << ans << endl;
        }
    }

    return 0;
}
