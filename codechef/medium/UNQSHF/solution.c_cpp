#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int T;
    cin >> T;

    while (T--) {
        int N;
        string A, B;

        cin >> N;
        cin >> A >> B;

        int countA = 0, countB = 0;

        for (char ch : A) {
            if (ch == 'a')
                countA++;
        }

        for (char ch : B) {
            if (ch == 'a')
                countB++;
        }

        if (countA + countB == N)
            cout << "YES" << endl;
        else
            cout << "NO" << endl;
    }

    return 0;

}
