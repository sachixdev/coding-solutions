#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin >> t;
	while(t--){
	    int N,K;
	    cin>>N>>K;
	    vector<int>A(N);
	    for(int i = 0;i<N;i++){
	        cin >> A[i];
	        
	    }
	    int len = N-K;
	    long long sum = 0;
	    for(int i = 0; i< len; i++){
	        sum +=A[i];
	        
	    }
	    long long ans = sum;
	    for(int i = len; i<N ; i++){
	        sum += A[i];
	        sum -=A[i - len];
	        ans = max(ans,sum);
	        
	    }
	    cout<< ans <<"\n";
	}
	return 0;

}
